<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.end_of_term.mapper.CouponMapper">

    <resultMap id="BaseResultMap" type="com.example.end_of_term.entity.Coupon">
        <id column="coupon_id" property="couponId"/>
        <result column="user_id" property="userId"/>
        <result column="amount" property="amount"/>
        <result column="is_used" property="isUsed"/>
        <result column="create_time" property="createTime"/>
        <result column="use_time" property="useTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        coupon_id, user_id, amount, is_used, create_time, use_time
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM coupon WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="selectAvailableByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM coupon WHERE user_id = #{userId} AND is_used = 0 ORDER BY amount DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM coupon WHERE coupon_id = #{couponId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="couponId">
        INSERT INTO coupon (user_id, amount, is_used, create_time)
        VALUES (#{userId}, #{amount}, 0, NOW())
    </insert>

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="couponId">
        INSERT INTO coupon (user_id, amount, is_used, create_time) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.amount}, 0, NOW())
        </foreach>
    </insert>

    <update id="markUsed">
        UPDATE coupon SET is_used = 1, use_time = NOW() WHERE coupon_id = #{couponId}
    </update>

    <delete id="deleteByUserId">
        DELETE FROM coupon WHERE user_id = #{userId}
    </delete>

</mapper>
