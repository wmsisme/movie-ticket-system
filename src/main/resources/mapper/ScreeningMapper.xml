<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.end_of_term.mapper.ScreeningMapper">

    <resultMap id="BaseResultMap" type="com.example.end_of_term.entity.Screening">
        <id column="screening_id" property="screeningId"/>
        <result column="movie_id" property="movieId"/>
        <result column="hall_id" property="hallId"/>
        <result column="screening_date" property="screeningDate"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="price" property="price"/>
        <result column="version" property="version"/>
        <result column="language" property="language"/>
    </resultMap>

    <sql id="Base_Column_List">
        screening_id, movie_id, hall_id, screening_date, start_time, end_time, price, version, language
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM screening ORDER BY screening_date, start_time
    </select>

    <select id="selectByMovieId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM screening WHERE movie_id = #{movieId} ORDER BY screening_date, start_time
    </select>

    <select id="selectByHallId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM screening WHERE hall_id = #{hallId} ORDER BY screening_date, start_time
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM screening WHERE screening_id = #{screeningId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="screeningId">
        INSERT INTO screening (movie_id, hall_id, screening_date, start_time, end_time, price, version, language)
        VALUES (#{movieId}, #{hallId}, #{screeningDate}, #{startTime}, #{endTime}, #{price}, #{version}, #{language})
    </insert>

    <update id="update">
        UPDATE screening
        <set>
            <if test="movieId != null">movie_id = #{movieId},</if>
            <if test="hallId != null">hall_id = #{hallId},</if>
            <if test="screeningDate != null">screening_date = #{screeningDate},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="price != null">price = #{price},</if>
            <if test="version != null">version = #{version},</if>
            <if test="language != null">language = #{language},</if>
        </set>
        WHERE screening_id = #{screeningId}
    </update>

    <delete id="deleteById">
        DELETE FROM screening WHERE screening_id = #{screeningId}
    </delete>

    <delete id="deleteByMovieId">
        DELETE FROM screening WHERE movie_id = #{movieId}
    </delete>

    <delete id="deleteByHallId">
        DELETE FROM screening WHERE hall_id = #{hallId}
    </delete>

</mapper>
